{
  "name": "agents-manager",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.1"
    },
    "id": "agents-manager",
    "name": "Agents",
    "icon": "assets/agents.svg",
    "contributes": {
      "panel": {
        "entry": "panel/index.html"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      },
      "capabilities": ["files"],
      "filesystem": [
        "~/.config/opencode/agents",
        "~/.config/opencode/agents/**",
        "~/.config/opencode/agent",
        "~/.config/opencode/agent/**",
        "~/.config/openchamber/preferences.json",
        "~/.config/opencode/opencode.json"
      ]
    }
  },
  "dependencies": {
    "@openchamber/sdk": "2.7.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4"
  }
}
